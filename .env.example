# File này dùng cho `docker-compose.yml` ở thư mục gốc.
# Copy thành ".env" (cùng cấp với docker-compose.yml) rồi chỉnh lại trước khi deploy thật.

# Domain thật đã trỏ DNS về IP server này (bắt buộc)
DOMAIN=khamtuyen.matachau.com

# Email nhận cảnh báo từ Let's Encrypt khi cert sắp hết hạn (bắt buộc)
ACME_EMAIL=kythuat@matachau.com

POSTGRES_DB=qraeh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=minhtoan@2026

# CORS cho API. Vì web gọi API qua cùng origin (Nginx proxy) nên thường không
# cần nới. Chỉ đổi nếu bạn expose thẳng API ra ngoài cho hệ thống khác gọi:
# WEB_ORIGIN=https://quanly.matachau.com
WEB_ORIGIN=khamtuyen.matachau.com
